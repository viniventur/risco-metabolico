  "info": {
    "description": "Os dados exibidos são fictícios e servem apenas para demonstração. Nenhum registro corresponde a uma pessoa real. Esta ferramenta é de triagem e não substitui avaliação clínica.",
    "summary": "Triagem metabólica: 16 respostas, distribuição entre 7 faixas e risco acumulado.",
    "title": "Triagem Metabólica",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Estado do serviço. O banco e o log de predição aparecem, mas nunca derrubam a resposta.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Vivacidade: sempre 200, mesmo com banco ou log degradados.",
        "tags": [
          "infraestrutura"
        ]
      }
    },
    "/api/v1/metadata": {
      "get": {
        "description": "O React monta o formulário a partir daqui; nenhuma regra de formulário mora no JSX.",
        "operationId": "metadata_api_v1_metadata_get",
        "parameters": [
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosFormulario"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Especificação do formulário: grupos, campos, tipos, faixas, opções e defaults",
        "tags": [
          "formulario"
        ]
      }
    },
    "/api/v1/model/feature-importance": {
      "get": {
        "description": "As `top` features mais importantes; o IMC derivado entra como uma feature.",
        "operationId": "feature_importance_api_v1_model_feature_importance_get",
        "parameters": [
          {
            "in": "query",
            "name": "top",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 20,
              "minimum": 1,
              "title": "Top",
              "type": "integer"
            }
          },
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportanciaFeatures"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Importância das features de entrada (one-hot somado), em ordem decrescente",
        "tags": [
          "modelo"
        ]
      }
    },
    "/api/v1/model/info": {
      "get": {
        "description": "Versão, algoritmo, `treinado_em`, hiperparâmetros, métricas de teste e ambiente.",
        "operationId": "model_info_api_v1_model_info_get",
        "parameters": [
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoModelo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Manifest normalizado: versão, métricas, ambiente",
        "tags": [
          "modelo"
        ]
      }
    },
    "/api/v1/predicoes": {
      "post": {
        "description": "Uma pessoa, 16 respostas, 7 probabilidades em ordem clínica e o risco acumulado.",
        "operationId": "prever_individuo_api_v1_predicoes_post",
        "parameters": [
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaTriagem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaTriagem"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Estima a distribuição entre as 7 faixas e o risco metabólico acumulado",
        "tags": [
          "predicoes"
        ]
      }
    },
    "/api/v1/predicoes/lote": {
      "post": {
        "description": "Valida item a item dentro do laço: o inválido volta em `falhas` com o índice de origem.",
        "operationId": "prever_lote_api_v1_predicoes_lote_post",
        "parameters": [
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteTriagem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLote"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Lote acima de LIMITE_LOTE"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Estima o risco para vários indivíduos de uma vez; um item inválido não derruba o lote",
        "tags": [
          "predicoes"
        ]
      }
    },
    "/api/v1/predicoes/relatorio": {
      "post": {
        "description": "HTML autocontido. O `nome` existe no HTML devolvido e em lugar nenhum além disso.",
        "operationId": "gerar_relatorio_api_v1_predicoes_relatorio_post",
        "parameters": [
          {
            "description": "Versão do modelo; padrão: a do manifest",
            "in": "query",
            "name": "versao",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Versão do modelo; padrão: a do manifest",
              "title": "Versao"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaRelatorio"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/html": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Gera o relatório HTML imprimível do indivíduo avaliado",
        "tags": [
          "predicoes"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Prontidão para receber tráfego. O banco não entra: o produto abre inteiro sem ele.",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prontidao"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prontidao"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Prontidão: 200 com artefato e agregados carregados, 503 caso contrário.",
        "tags": [
          "infraestrutura"
        ]
      }
    }
  }
}
