{
  "components": {
    "schemas": {
      "CampoFormulario": {
        "additionalProperties": false,
        "description": "Um campo do formulário de triagem; `nome` é a CHAVE do JSON de `EntradaTriagem`.",
        "properties": {
          "ajuda": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ajuda"
          },
          "maximo": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maximo"
          },
          "minimo": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimo"
          },
          "nome": {
            "title": "Nome",
            "type": "string"
          },
          "opcoes": {
            "items": {
              "$ref": "#/components/schemas/OpcaoCampo"
            },
            "title": "Opcoes",
            "type": "array"
          },
          "padrao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Padrao"
          },
          "passo": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passo"
          },
          "rotulo": {
            "title": "Rotulo",
            "type": "string"
          },
          "tipo": {
            "enum": [
              "numero",
              "selecao"
            ],
            "title": "Tipo",
            "type": "string"
          }
        },
        "required": [
          "nome",
          "rotulo",
          "tipo"
        ],
        "title": "CampoFormulario",
        "type": "object"
      },
      "EntradaRelatorio": {
        "additionalProperties": false,
        "description": "Corpo de `POST /predicoes/relatorio`: a entrada mais o nome opcional (só metadado).",
        "properties": {
          "entrada": {
            "$ref": "#/components/schemas/EntradaTriagem"
          },
          "nome": {
            "default": "",
            "maxLength": 120,
            "title": "Nome",
            "type": "string"
          }
        },
        "required": [
          "entrada"
        ],
        "title": "EntradaRelatorio",
        "type": "object"
      },
      "EntradaTriagem": {
        "additionalProperties": false,
        "description": "Os 16 campos que o pipeline espera, com o domínio fechado de cada um.",
        "example": {
          "Altura": 1.7,
          "Atividade_Fisica_Frequencia": 1,
          "Consumo_Agua_Diario": 2,
          "Consumo_Alcool": "Não",
          "Consumo_Alimentos_Entre_Refeicoes": "Às vezes",
          "Consumo_Calorico_Frequente": "Sim",
          "Consumo_Vegetais": 2,
          "Fumante": "Não",
          "Genero": "Feminino",
          "Historico_Familiar_Sobrepeso": "Sim",
          "Idade": 25,
          "Meio_Transporte": "Transporte Público",
          "Monitoramento_Calorias": "Não",
          "Numero_Refeicoes_Principais": 3,
          "Peso": 70.0,
          "Tempo_Dispositivos_Tecnologicos": 0
        },
        "properties": {
          "Altura": {
            "maximum": 2.0,
            "minimum": 1.4,
            "title": "Altura",
            "type": "number"
          },
          "Atividade_Fisica_Frequencia": {
            "description": "0 nenhuma, 1 1-2x, 2 3-4x, 3 5+x por semana",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Atividade Fisica Frequencia",
            "type": "integer"
          },
          "Consumo_Agua_Diario": {
            "description": "1 <1L, 2 1-2L, 3 >2L por dia",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Consumo Agua Diario",
            "type": "integer"
          },
          "Consumo_Alcool": {
            "$ref": "#/components/schemas/Frequencia"
          },
          "Consumo_Alimentos_Entre_Refeicoes": {
            "$ref": "#/components/schemas/Frequencia"
          },
          "Consumo_Calorico_Frequente": {
            "$ref": "#/components/schemas/SimNao"
          },
          "Consumo_Vegetais": {
            "description": "1 raramente, 2 às vezes, 3 sempre",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Consumo Vegetais",
            "type": "integer"
          },
          "Fumante": {
            "$ref": "#/components/schemas/SimNao"
          },
          "Genero": {
            "$ref": "#/components/schemas/Genero"
          },
          "Historico_Familiar_Sobrepeso": {
            "$ref": "#/components/schemas/SimNao"
          },
          "Idade": {
            "maximum": 61.0,
            "minimum": 14.0,
            "title": "Idade",
            "type": "number"
          },
          "Meio_Transporte": {
            "$ref": "#/components/schemas/MeioTransporte"
          },
          "Monitoramento_Calorias": {
            "$ref": "#/components/schemas/SimNao"
          },
          "Numero_Refeicoes_Principais": {
            "description": "Refeições principais por dia (4 = 4 ou mais)",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Numero Refeicoes Principais",
            "type": "integer"
          },
          "Peso": {
            "maximum": 175.0,
            "minimum": 39.0,
            "title": "Peso",
            "type": "number"
          },
          "Tempo_Dispositivos_Tecnologicos": {
            "description": "0 0-2h, 1 3-5h, 2 >5h por dia",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Tempo Dispositivos Tecnologicos",
            "type": "integer"
          }
        },
        "required": [
          "Genero",
          "Idade",
          "Altura",
          "Peso",
          "Historico_Familiar_Sobrepeso",
          "Consumo_Calorico_Frequente",
          "Consumo_Vegetais",
          "Numero_Refeicoes_Principais",
          "Consumo_Alimentos_Entre_Refeicoes",
          "Fumante",
          "Consumo_Agua_Diario",
          "Monitoramento_Calorias",
          "Atividade_Fisica_Frequencia",
          "Tempo_Dispositivos_Tecnologicos",
          "Consumo_Alcool",
          "Meio_Transporte"
        ],
        "title": "EntradaTriagem",
        "type": "object"
      },
      "FalhaLote": {
