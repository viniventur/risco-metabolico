        "title": "FalhaLote",
        "type": "object"
      },
      "Frequencia": {
        "description": "Lanches entre refeições e álcool: os quatro níveis do dicionário.",
        "enum": [
          "Não",
          "Às vezes",
          "Frequentemente",
          "Sempre"
        ],
        "title": "Frequencia",
        "type": "string"
      },
      "Genero": {
        "description": "Sexo biológico, como no dicionário de dados.",
        "enum": [
          "Feminino",
          "Masculino"
        ],
        "title": "Genero",
        "type": "string"
      },
      "GrupoFormulario": {
        "description": "Os três agrupamentos do legado: dados iniciais, dieta, hábitos.",
