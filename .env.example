# .env.example — copie para .env e ajuste. .env está no .gitignore.
# As 22 variáveis de backend do plano (§11.3), na mesma ordem, e a da vertente diabetes, ao lado da
# de deriva da obesidade, sem um único valor real:
# os valores locais são os do compose, descartáveis de propósito, e o que é segredo fica vazio.
MODELOS_DIR=./models
ARTEFATOS_DIR=./artifacts
DADOS_DIR=./data/processado
SQL_DIR=./sql
ORIGENS_CORS=http://localhost:5173
EXIGIR_INTEGRIDADE=false
VERSAO_API=1
LIMITE_LOTE=500
# Local (docker compose): esta linha é literal e não é segredo.
BANCO_URL=postgresql://postgres:postgres@localhost:55432/app_local
# Publicado: use o host do POOLER. NUNCA commitar a senha.
# BANCO_URL=postgresql://<usuario>:<senha>@<host-do-pooler>:6543/<banco>
BANCO_HABILITADO=true
BANCO_POOL_MAX=3
BANCO_TIMEOUT_CONEXAO_S=5
BANCO_TIMEOUT_CONSULTA_S=3
BANCO_TIMEOUT_ACORDAR_S=20
LOG_PREDICAO_HABILITADO=true
LOG_PREDICAO_FILA_MAX=500
LIMITE_PAYLOAD_LOG_BYTES=16384
LIMITE_TAXA_ATIVO=false
LIMITE_TAXA_PREDICAO=30/minute;300/hour
LIMITE_TAXA_LOTE=3/minute;20/hour
# Sem default e sem valor aqui: a API recusa subir com LIMITE_TAXA_ATIVO=true e SAL_TAXA vazio.
# Gere com:
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
SAL_TAXA=
# Medido em F8b pelo critério de §6.8.5 (tools/medir_n_minimo_deriva.py, ADR 0008): o menor n
# para o qual o PSI de uma reamostragem do treino contra ele mesmo fica abaixo de 0,10.
N_MINIMO_DERIVA=200
# O da vertente diabetes, pelo mesmo método (tools/medir_n_minimo_deriva.py --vertente diabetes),
# registrado em artifacts/diabetes/metricas/n-minimo-deriva.json. Não é obrigatória: sem ela a API
# sobe e só /api/v1/diabetes/monitoramento/deriva responde disponivel=false.
N_MINIMO_DERIVA_DIABETES=300

# ---- docker compose (local). Na VPS, scripts/deploy.sh grava estes valores a partir dos secrets ----
# e variables do GitHub; aqui são os defaults do docker-compose.yml, descartáveis de propósito.
POSTGRES_DB=app_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
API_DB_USER=triagem_api
API_DB_PASSWORD=triagem_api_local
POSTGRES_HOST_PORT=55432
API_HOST_PORT=8000
WEB_HOST_PORT=8080
RETENCAO_DIAS=90
TETO_LINHAS_LOG=500000
