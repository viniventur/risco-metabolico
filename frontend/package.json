    "dompurify": "3.4.17",
    "katex": "^0.16.22",
    "nuqs": "2.10.2",
    "openapi-fetch": "0.17.0",
    "plotly.js-cartesian-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-is": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
